# Copy to .env.deploy in this directory (never commit .env.deploy).
# Docs: apps/web/docs/deploy.md
#
# Local deploy: source this file from the monorepo root, then run scp in the doc.
# GitHub Actions: same names as repository Secrets (plus DEPLOY_SSH_KEY for CI).

# Server SSH target
DEPLOY_HOST=
DEPLOY_USER=
DEPLOY_PORT=22

# Remote directories (must already exist on the server)
DEPLOY_SITE_PATH=~/dev/caddy/site
DEPLOY_DOWNLOADS_PATH=~/dev/caddy/downloads
