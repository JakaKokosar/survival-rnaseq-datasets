---
import TutorialButton from './TutorialButton.svelte';

interface Props {
	title: string;
}

const { title } = Astro.props;

const SOURCE_CODE_URL = 'https://github.com/JakaKokosar/survival-rnaseq-datasets';
const actionButtonClass =
	'inline-flex items-center gap-1.5 rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 shadow-sm transition-colors hover:bg-slate-50 hover:text-slate-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-2';
---

<header class="border-b border-slate-200 bg-white">
	<div class="flex items-center justify-between gap-4 px-6 py-4">
		<div class="flex min-w-0 items-center gap-3">
			<img
				src="/favicon.svg"
				alt=""
				width="56"
				height="56"
				class="h-14 w-14 shrink-0"
				aria-hidden="true"
			/>
			<h1 class="min-w-0 text-2xl font-semibold text-slate-900">{title}</h1>
		</div>
		<div class="flex shrink-0 items-center gap-2">
			<a
				href={SOURCE_CODE_URL}
				target="_blank"
				rel="noopener noreferrer"
				class={actionButtonClass}
			>
				<svg
					aria-hidden="true"
					class="h-4 w-4 shrink-0"
					viewBox="0 0 16 16"
					fill="currentColor"
				>
					<path
						d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8"
					></path>
				</svg>
				Source Code
			</a>
			<TutorialButton client:load />
		</div>
	</div>
</header>
