---
import '../styles/global.css'
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content="Browse and explore survival analysis datasets from GEO (Gene Expression Omnibus). View dataset statistics, survival endpoints, and access NCBI GEO links." />
		<meta name="theme-color" content="#ffffff" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>Survival Analysis Datasets</title>
	</head>
	<body class="flex h-screen flex-col overflow-hidden">
		<!-- 
			Skip link: Allows keyboard/screen reader users to bypass header 
			and jump directly to main content (WCAG 2.4.1 Bypass Blocks)
		-->
		<a 
			href="#main-content" 
			class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:bg-white focus:px-4 focus:py-2 focus:rounded focus:shadow-lg focus:text-blue-600 focus:underline"
		>
			Skip to main content
		</a>
		<slot />
	</body>
</html>
