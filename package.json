{
  "name": "survival-rnaseq-data",
  "private": true,
  "version": "0.0.1",
  "packageManager": "pnpm@10.32.0",
  "scripts": {
    "dev": "pnpm --filter @survival-rnaseq/web dev",
    "build": "pnpm --filter @survival-rnaseq/web build",
    "preview": "pnpm --filter @survival-rnaseq/web preview",
    "test": "pnpm test:data && pnpm test:web",
    "test:web": "pnpm --filter @survival-rnaseq/web test",
    "test:data": "uv run --project datasets python -m unittest discover -s datasets/tests -v",
    "data:setup": "uv sync --project datasets",
    "data:assemble": "uv run --project datasets python datasets/tools/data_pipeline.py assemble"
  }
}
